rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isOwner(tenantId) {
      return isAuthenticated() && 
             (request.auth.token.role == 'admin' || 
              request.auth.token.tenantId == tenantId);
    }
    
    function isVehicleImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024;
    }

    function isAllowedVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)') &&
             request.resource.size < 100 * 1024 * 1024;
    }

    // Vehicle photos and videos
    match /tenants/{tenantId}/vehicles/{vehicleId}/{allPaths=**} {
      allow read: if true; // Público para webs
      allow write: if isOwner(tenantId) && (isVehicleImage() || isAllowedVideo());
    }

    // Promo / campaign / ad media
    match /tenants/{tenantId}/videos/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(tenantId) && isAllowedVideo();
    }

    match /tenants/{tenantId}/images/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(tenantId) && isVehicleImage();
    }

    match /tenants/{tenantId}/{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(tenantId) &&
                      folder.matches('promotions|campaigns|ads|sponsored_content') &&
                      (isVehicleImage() || isAllowedVideo());
    }
    
    // User avatars
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && 
                      (isAdmin() || request.auth.uid == userId) &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB
                      request.resource.contentType.matches('image/.*');
    }
    
    // Documents (sales, etc)
    match /tenants/{tenantId}/documents/{allPaths=**} {
      allow read: if isOwner(tenantId);
      allow write: if isOwner(tenantId) && 
                      request.resource.size < 50 * 1024 * 1024; // 50MB
    }
    
    // Branding (logos, favicons)
    match /tenants/{tenantId}/branding/{allPaths=**} {
      allow read: if true; // Público
      allow write: if isOwner(tenantId) && 
                      request.resource.size < 2 * 1024 * 1024 && // 2MB
                      request.resource.contentType.matches('image/.*');
    }

    // Marca del panel admin (subida vía Admin SDK a admin/branding/…; lectura pública con ?token=)
    match /admin/branding/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}





