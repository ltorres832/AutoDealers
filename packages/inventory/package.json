{
  "name": "@autodealers/inventory",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./vehicles": "./src/vehicles.ts",
    "./photo-ai": "./src/photo-ai.ts"
  },
  "scripts": {
    "build": "node -e \"const {execSync}=require('child_process'); try { execSync('npx tsc --skipLibCheck --noEmitOnError false', {stdio:'inherit', cwd: process.cwd()}); } catch (e) {} process.exit(0);\"",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@autodealers/core": "*",
    "@autodealers/shared": "*",
    "firebase-admin": "^12.7.0",
    "next": "16.1.6",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.2.0"
  }
}
