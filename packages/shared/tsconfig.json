{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declarationDir": "./types",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "composite": true,
    "incremental": true,
    "declaration": true,
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "files": [],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}